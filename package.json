    "links:check": "node scripts/check-links.mjs",
    "backup": "node scripts/backup.mjs",
    "videos:verify": "node scripts/verify-videos.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "curriculum:doc": "node scripts/build-curriculum-doc.mjs",
    "sequence:doc": "node scripts/build-sequence-doc.mjs",
    "videos:coverage": "node scripts/build-video-coverage.mjs",
